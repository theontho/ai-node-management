# Copy this file to local/benchmark.env and adjust paths for the current host.
BENCHMARK_INSTALL_ROOT="$HOME/.local/share/cli-benchmark"
BENCHMARK_OUTPUT="$ROOT/output/agent-cli-benchmark"
BENCHMARK_AGENTS="opencode pi copilot moltis hermes crush openclaw"

# Existing authenticated client state. These values are paths, never tokens.
OPENCODE_AUTH_FILE="$HOME/.local/share/opencode/auth.json"
PI_AUTH_DIR="$HOME/.pi/agent"
COPILOT_HOME="$HOME/.copilot"
MOLTIS_AUTH_CONFIG_DIR="$HOME/.config/moltis"
HERMES_AUTH_FILE="$HOME/.hermes/auth.json"
CRUSH_DATA_DIR="$HOME/.local/share/crush"
OPENCLAW_STATE_DIR="$HOME/.openclaw"
