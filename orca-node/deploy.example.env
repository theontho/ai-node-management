# Copy to local/deploy.env and customize.
SSH_TARGET=node-admin@ai-node-linux.local
NODE_NAME=ai-node-linux
ENVIRONMENT_NAME=ai-node-linux
TAILSCALE_AUTH_KEY_FILE=./local/private/tailscale-auth-key
ORCA_KEYRING_PASSWORD_FILE=./local/private/orca-keyring-password
DATA_ROOT=/data/orca-node
WORKSPACE_ROOT=/srv/orca-node/workspaces
