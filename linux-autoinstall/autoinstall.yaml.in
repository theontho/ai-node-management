#cloud-config
autoinstall:
  version: 1
  interactive-sections: __INTERACTIVE_SECTIONS__
  early-commands:
__DISK_SELECTION_EARLY_COMMAND__
    - |
      node_name=$(
        /cdrom/nocloud/assets/generate-node-name __NODE_NAME_PREFIX_SHELL__
      )
      sed -i \
        "s/^    hostname: AI_NODE_RUNTIME_HOSTNAME$/    hostname: $node_name/" \
        /autoinstall.yaml
__WIFI_EARLY_COMMANDS__
  locale: en_US.UTF-8
  keyboard:
    layout: us
    variant: ""
  timezone: __TIMEZONE__
  refresh-installer:
    update: false
  updates: all
  proxy: null
  codecs:
    install: false
  drivers:
    install: true
  oem:
    install: false
  source:
    id: ubuntu-server
    search_drivers: true
  network:
    version: 2
    ethernets:
      wired:
        match:
          name: "e*"
        dhcp4: true
        optional: true
__WIFI_NETWORK__
  apt:
    geoip: false
    fallback: offline-install
    preserve_sources_list: false
  identity:
    hostname: AI_NODE_RUNTIME_HOSTNAME
    username: __ADMIN_USER__
    password: __PASSWORD_HASH__
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - __SSH_PUBLIC_KEY__
  packages:
    - avahi-daemon
    - libnss-mdns
    - openssh-server
__WIFI_PACKAGE__
__STORAGE_CONFIG__
  shutdown: reboot
  late-commands:
    - install -D -m 0440 /cdrom/nocloud/assets/admin-sudoers /target/etc/sudoers.d/90-ai-node-admin
    - install -D -m 0644 /cdrom/nocloud/assets/apt-noninteractive.conf /target/etc/apt/apt.conf.d/90-ai-node-noninteractive
    - install -D -m 0600 /cdrom/nocloud/assets/debconf-selections /target/tmp/ai-node-debconf-selections
    - curtin in-target --target=/target -- debconf-set-selections /tmp/ai-node-debconf-selections
    - rm -f /target/tmp/ai-node-debconf-selections
__WIFI_LATE_COMMAND__
    - install -D -m 0644 /cdrom/nocloud/assets/ssh-access.conf /target/etc/ssh/sshd_config.d/90-ai-node.conf
    - install -D -m 0600 /cdrom/nocloud/private/tailscale-auth-key /target/etc/ai-node/tailscale-auth-key
    - install -D -m 0644 /cdrom/nocloud/packages/tailscale.deb /target/tmp/tailscale.deb
    - curtin in-target --target=/target -- env DEBIAN_FRONTEND=noninteractive apt-get install -y /tmp/tailscale.deb
    - rm -f /target/tmp/tailscale.deb
    - install -D -m 0755 /cdrom/nocloud/assets/enroll-tailscale /target/usr/local/sbin/enroll-tailscale
    - install -D -m 0644 /cdrom/nocloud/assets/ai-node-tailscale-enroll.service /target/etc/systemd/system/ai-node-tailscale-enroll.service
    - install -D -m 0644 /cdrom/nocloud/assets/swap.conf /target/etc/default/ai-node-swap
    - install -D -m 0755 /cdrom/nocloud/assets/configure-swap /target/usr/local/sbin/configure-swap
    - curtin in-target --target=/target -- /usr/local/sbin/configure-swap prepare-only
    - install -D -m 0644 /cdrom/nocloud/assets/console-power.conf /target/etc/default/ai-node-console-power
    - install -D -m 0755 /cdrom/nocloud/assets/manage-console-backlight /target/usr/local/sbin/manage-console-backlight
    - install -D -m 0644 /cdrom/nocloud/assets/ai-node-console-power.service /target/etc/systemd/system/ai-node-console-power.service
    - install -D -m 0755 /cdrom/nocloud/assets/render-console-health /target/usr/local/sbin/render-console-health
    - install -D -m 0644 /cdrom/nocloud/assets/ai-node-console-health.service /target/etc/systemd/system/ai-node-console-health.service
    - install -D -m 0644 /cdrom/nocloud/assets/ai-node-console-health.timer /target/etc/systemd/system/ai-node-console-health.timer
    - install -D -m 0644 /cdrom/nocloud/assets/getty-console-health.conf /target/etc/systemd/system/getty@tty1.service.d/console-health.conf
    - curtin in-target --target=/target -- visudo --check --file=/etc/sudoers.d/90-ai-node-admin
    - curtin in-target --target=/target -- ssh-keygen -A
    - curtin in-target --target=/target -- install -d -m 0755 /run/sshd
    - curtin in-target --target=/target -- sshd -t
    - curtin in-target --target=/target -- systemctl enable ai-node-console-power.service ai-node-console-health.timer ai-node-tailscale-enroll.service avahi-daemon ssh tailscaled
    - install -D -m 0644 /dev/null /target/boot/efi/EFI/ubuntu/.ai-node-install-complete
