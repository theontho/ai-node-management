# Copy to local/config.env and customize for the target hardware.
NODE_NAME_PREFIX=lin
ADMIN_USER=node-admin
TIMEZONE=Etc/UTC
SYSTEM_DISK=auto
# Use auto for every remaining internal disk, leave empty to preserve all
# secondary disks, or provide one explicit /dev path.
DATA_DISK=auto
DATA_MOUNT=/data
PREFERRED_MIN_TARGET_DISK_BYTES=60000000000
SWAP_SIZE_GIB=16
SWAPPINESS=10
CONSOLE_IDLE_SECONDS=60
