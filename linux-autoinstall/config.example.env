# Copy to local/config.env and customize for the target hardware.
NODE_NAME=ai-node-linux
ADMIN_USER=node-admin
TIMEZONE=Etc/UTC
SYSTEM_DISK=/dev/disk/by-id/system-disk-id
# Leave empty for a single-disk installation.
DATA_DISK=/dev/disk/by-id/data-disk-id
DATA_MOUNT=/data
SWAP_SIZE_GIB=16
SWAPPINESS=10
CONSOLE_IDLE_MINUTES=5
