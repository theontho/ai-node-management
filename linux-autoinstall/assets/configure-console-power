#!/bin/bash
set -euo pipefail

# shellcheck disable=SC1091
. /etc/default/ai-node-console-power

export TERM=linux

[[ "${CONSOLE_IDLE_MINUTES:-}" =~ ^[0-9]+$ ]] \
  && (( CONSOLE_IDLE_MINUTES >= 1 && CONSOLE_IDLE_MINUTES <= 60 )) || {
  echo "CONSOLE_IDLE_MINUTES must be an integer from 1 through 60" >&2
  exit 1
}
[[ -c /dev/tty1 ]] || {
  echo "/dev/tty1 is unavailable" >&2
  exit 1
}

setterm --blank "$CONSOLE_IDLE_MINUTES" < /dev/tty1 > /dev/tty1
if ! setterm --powersave powerdown --powerdown 1 < /dev/tty1 > /dev/tty1; then
  logger -t ai-node-console-power \
    "Display powerdown is unsupported; console blanking remains enabled"
fi
